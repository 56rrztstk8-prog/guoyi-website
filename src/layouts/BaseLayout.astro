---
import "../styles/global.css";
import PageHead from "../components/PageHead.astro";
import LeftMenu from "../components/LeftMenu.astro";

interface Props {
  title?: string;
  description?: string;
  showMenu?: boolean;
  menuMode?: "hover" | "persistent";
}

const { title, description, showMenu = true, menuMode = "persistent" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead title={title} description={description} />
  </head>
  <body>
    {showMenu && <LeftMenu mode={menuMode} />}
    <main>
      <slot />
    </main>
    <footer>
      <span>&copy; Guo Yi</span>
    </footer>
  </body>
</html>

<style>
  body:has(.menu-persistent) main {
    margin-left: var(--menu-width);
  }

  footer {
    position: fixed;
    bottom: 1.2rem;
    right: 1.5rem;
    font-size: 0.7rem;
    color: var(--color-text-light);
    letter-spacing: 0.05em;
    z-index: 50;
  }
</style>
