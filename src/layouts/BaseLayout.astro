---
import "../styles/global.css";
import PageHead from "../components/PageHead.astro";
import LeftMenu from "../components/LeftMenu.astro";

interface Props {
  title?: string;
  description?: string;
  showMenu?: boolean;
  menuMode?: "hover" | "persistent";
}

const { title, description, showMenu = true, menuMode = "persistent" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead title={title} description={description} />
  </head>
  <body>
    {showMenu && <LeftMenu mode={menuMode} />}
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body:has(.menu-persistent) main {
    margin-left: var(--menu-width);
  }
</style>
