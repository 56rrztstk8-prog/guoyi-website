---
import { site } from "../data/site";

interface Props {
  mode?: "hover" | "persistent";
}

const { mode = "persistent" } = Astro.props;
---

<style>
  /* Persistent mode: always visible */
  .menu-persistent .menu-trigger,
  .menu-persistent .menu-toggle-input,
  .menu-persistent .menu-toggle-label {
    display: none;
  }

  .menu-persistent .menu-panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    pointer-events: auto;
  }

  .menu-trigger {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--menu-trigger-width);
    z-index: 100;
  }

  /* Hidden checkbox for CSS-only toggle */
  .menu-toggle-input {
    position: fixed;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  /* Hamburger label — visible on hover near left edge or when menu is open */
  .menu-toggle-label {
    position: fixed;
    left: 4px;
    top: 12px;
    z-index: 101;
    cursor: pointer;
    font-size: 1.1rem;
    color: var(--color-text-light, #666);
    user-select: none;
    opacity: 0;
    transition: opacity 0.2s;
    line-height: 1;
  }

  /* Show hamburger when hovering the trigger zone */
  .menu-trigger:hover ~ .menu-toggle-label,
  .menu-toggle-label:hover {
    opacity: 1;
  }

  /* Keep hamburger visible when menu is toggled open */
  .menu-toggle-input:checked ~ .menu-toggle-label {
    opacity: 1;
  }

  /* Show hamburger when it receives focus (keyboard users) */
  .menu-toggle-label:focus-within {
    opacity: 1;
  }

  /* 菜单默认隐藏 */
  .menu-panel {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--menu-width);
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    padding: 6vh 2rem;
    z-index: 99;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-12px);
    transition: var(--transition-menu);
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* 悬停触发区时显示菜单 */
  .menu-trigger:hover ~ .menu-panel,
  .menu-panel:hover {
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* Open via checkbox toggle (keyboard + touch) */
  .menu-toggle-input:checked ~ .menu-panel {
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .menu-label {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--color-text-light);
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .menu-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .menu-nav a {
    font-size: var(--font-size-nav);
    letter-spacing: 0.05em;
    transition: color 0.2s;
  }

  .menu-nav a:hover {
    color: var(--color-text-light);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel {
      transition: none;
    }
  }
</style>

<div class={mode === "hover" ? "menu-hover" : "menu-persistent"}>
<!-- Hidden checkbox for CSS-only toggle (keyboard + touch access) -->
<input type="checkbox" id="menu-toggle" class="menu-toggle-input" />

<!-- 左侧触发区：一个不可见的窄条 -->
<div class="menu-trigger" aria-hidden="true"></div>

<!-- Hamburger toggle label — visible on hover or when menu is open -->
<label for="menu-toggle" class="menu-toggle-label" aria-label="打开菜单">☰</label>

<nav class="menu-panel" aria-label="主导航">
  <span class="menu-label">目录</span>
  <ul class="menu-nav">
    {site.nav.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>
</nav>
</div>
