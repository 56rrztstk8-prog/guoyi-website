---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const statement = `Guo Yi, born 2007 in Henan, currently lives and works in Shanghai. Her practice spans painting, photography, and video. She describes her working method as thread-weaving—incorporating fragments of information from personal experience, mythological texts, and everyday imagery into the structure of a work around a gradually emerging central thread. In painting, this method manifests as area-by-area filling; in video, as the jump-cut assembly of materials. She bypasses the uniform treatment of source materials, instead preserving the temporal properties and traces of use each carries as it is woven in, allowing the interplay between collage, scraping, flat painting, and silhouette on the picture plane to become a result of the method itself. The photographic series Web and Wyrd draws from three mythological systems narratives related to weaving: Spider Grandmother's creation of the world, Coyote's weaving of the stars, and the Valkyries' weaving of fate—Guo Yi reconstructs these stories into a new thread. Viewing the mythological traditions scattered across the globe as points of light on the earth's surface, creation narratives, totemic beliefs, and unsolved mysteries are connected into lines by threads, interweaving into a terrestrial net composed of points, lines, and planes. The net accommodates dark spaces, broken threads, and fading nodes. Her concern does not rest on the structure of the net itself, but extends to the process of deterioration in connections over time—how myths degrade from observation into stories, how symbols lose their referents through weathering, how connections break without notice. For her, the sense of composition is the trace left behind after the threads have been woven.`;

const mailtoHref = `mailto:${site.contact.email}`;
---

<BaseLayout title="About">
  <style>
    .page {
      max-width: 560px;
      margin: 0 auto;
      padding: 8vh var(--spacing-page);
    }

    .page h1 {
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      margin-bottom: 3rem;
      color: var(--color-text-light);
    }

    .statement {
      font-size: 0.85rem;
      line-height: 2.1;
      color: var(--color-text);
      white-space: pre-line;
      text-align: justify;
    }

    .contact-info {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.85rem;
      line-height: 2.1;
      color: var(--color-text);
    }

    .contact-info a {
      border-bottom: 1px solid var(--color-border);
      transition: border-color 0.2s;
    }

    .contact-info a:hover {
      border-color: var(--color-text-light);
    }
  </style>

  <div class="page">
    <h1>About</h1>
    <div class="statement">{statement}</div>
    <div class="contact-info">
      <p><a href={mailtoHref}>{site.contact.email}</a></p>
      <p>{site.contact.address}</p>
    </div>
  </div>
</BaseLayout>
