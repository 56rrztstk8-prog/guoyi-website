---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const statement = `Guo Yi, born 2007 in Henan, currently lives and works in Shanghai. Her practice spans painting, photography, and video. She describes her working method as thread-weaving—incorporating fragments of information from personal experience, mythological texts, and everyday imagery into the structure of a work around a gradually emerging central thread. In painting, this method manifests as pre-planned composition and layer-by-layer filling; in video, as handheld footage and the jump-cut assembly of found materials. She bypasses the uniform treatment of source materials, instead preserving the temporal properties and traces of use each carries as it is woven in, allowing the tension between collage, scraping, flat painting, and silhouette on the picture plane to become a material consequence of method rather than a stylistic decision. Viewing the mythological traditions scattered across the globe as points of light on the earth's surface—creation narratives, totemic beliefs, and unsolved mysteries are drawn into connecting lines by threads, interweaving into a terrestrial net composed of points, lines, and planes, which simultaneously accommodates dark spaces, broken threads, and fading nodes. Her concern does not rest on the structure of the net itself, but extends to the process of deterioration in connections over time—how myths degrade from observational records into stories, how symbols lose their referents through weathering, how threads break on their own when left unused. The sense of composition she understands is not formal law, but the projection of this net onto the picture plane: each incorporation of material is a remapping of some connection in the net, a reaffirmation of a node not yet faded.`;

const mailtoHref = `mailto:${site.contact.email}`;
---

<BaseLayout title="About">
  <style>
    .page {
      max-width: 560px;
      margin: 0 auto;
      padding: 8vh var(--spacing-page);
    }

    .page h1 {
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      margin-bottom: 3rem;
      color: var(--color-text-light);
    }

    .statement {
      font-size: 0.85rem;
      line-height: 2.1;
      color: var(--color-text);
      white-space: pre-line;
    }

    .contact-info {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.85rem;
      line-height: 2.1;
      color: var(--color-text);
    }

    .contact-info a {
      border-bottom: 1px solid var(--color-border);
      transition: border-color 0.2s;
    }

    .contact-info a:hover {
      border-color: var(--color-text-light);
    }
  </style>

  <div class="page">
    <h1>About</h1>
    <div class="statement">{statement}</div>
    <div class="contact-info">
      <p><a href={mailtoHref}>{site.contact.email}</a></p>
      <p>{site.contact.address}</p>
    </div>
  </div>
</BaseLayout>
