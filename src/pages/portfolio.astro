---
import BaseLayout from "../layouts/BaseLayout.astro";
import { worksByCategory } from "../data/works";

const basePath = (p: string) => import.meta.env.BASE_URL + p.replace(/^\//, "");
---

<BaseLayout title="Works">
  <style>
    .page {
      max-width: 640px;
      margin: 0 auto;
      padding: 8vh var(--spacing-page);
    }

    .page h1 {
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      margin-bottom: 3rem;
      color: var(--color-text-light);
    }

    .category {
      margin-bottom: 6rem;
    }

    .category-name {
      font-size: 0.95rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .work-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .work-item a {
      display: block;
    }

    .work-cover {
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      background: #eee;
      margin-bottom: 0.75rem;
    }

    .work-title {
      font-size: 0.95rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      margin-bottom: 0.2rem;
    }

    .work-subtitle {
      font-size: 0.7rem;
      color: var(--color-text-light);
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }

    .work-desc {
      font-size: 0.75rem;
      line-height: 1.7;
      color: #666;
    }
  </style>

  <div class="page">
    <h1>Works</h1>
    {Object.entries(worksByCategory).map(([cat, items]) => (
      items.length > 0 && (
        <section class="category">
          <h2 class="category-name">{cat}</h2>
          <ul class="work-list">
            {items.map((w) => (
              <li class="work-item">
                <a href={import.meta.env.BASE_URL + "works/" + w.slug}>
                  <img class="work-cover" src={basePath(w.cover)} alt={w.title} />
                  <div class="work-title">{w.title}</div>
                  <div class="work-subtitle">{w.subtitle}</div>
                  {w.shortDescription && <p class="work-desc">{w.shortDescription}</p>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    ))}
  </div>
</BaseLayout>
