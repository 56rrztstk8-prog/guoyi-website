---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="News & Exhibitions">
  <style>
    .page {
      max-width: 640px;
      margin: 0 auto;
      padding: 8vh var(--spacing-page);
    }

    .page h1 {
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      margin-bottom: 3rem;
      color: var(--color-text-light);
    }

    .empty {
      font-size: 0.8rem;
      color: var(--color-text-light);
      line-height: 1.8;
    }
  </style>

  <div class="page">
    <h1>News & Exhibitions</h1>
    <p class="empty">No exhibitions at this time.</p>
  </div>
</BaseLayout>
