---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { works } from "../../data/works";

export function getStaticPaths() {
  return works.map((w) => ({ params: { slug: w.slug } }));
}

const { slug } = Astro.params;
const work = works.find((w) => w.slug === slug);

if (!work) {
  return Astro.redirect("/portfolio");
}
---

<BaseLayout title={work.title}>
  <style>
    .page {
      max-width: 800px;
      margin: 0 auto;
      padding: 8vh var(--spacing-page);
    }

    .back-link {
      display: inline-block;
      font-size: 0.8rem;
      color: var(--color-text-light);
      letter-spacing: 0.08em;
      margin-bottom: 2.5rem;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: var(--color-text);
    }

    .work-header {
      margin-bottom: 3rem;
    }

    .work-title {
      font-size: 1.4rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      margin-bottom: 0.3rem;
    }

    .work-subtitle {
      font-size: 0.85rem;
      color: var(--color-text-light);
      letter-spacing: 0.05em;
    }

    .work-cover {
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      background: #eee;
      margin-bottom: 3rem;
    }

    .work-desc {
      font-size: 0.95rem;
      line-height: 2.1;
      color: var(--color-text);
      white-space: pre-line;
      margin-bottom: 3rem;
    }

    .work-video {
      margin-bottom: 3rem;
    }

    .carousel {
      position: relative;
      margin-bottom: 3rem;
    }

    .carousel-track {
      width: 100%;
    }

    .carousel-img {
      width: 100%;
      object-fit: contain;
      max-height: 80vh;
    }

    .carousel-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.7);
      border: none;
      font-size: 1.5rem;
      color: #333;
      cursor: pointer;
      padding: 0.5rem 0.8rem;
      z-index: 10;
      transition: background 0.2s;
      font-family: inherit;
      line-height: 1;
    }

    .carousel-btn:hover {
      background: rgba(255, 255, 255, 0.95);
    }

    .carousel-prev {
      left: -3rem;
    }

    .carousel-next {
      right: -3rem;
    }
  </style>

  <div class="page">
    <a class="back-link" href="/portfolio">← 作品集</a>
    <div class="work-header">
      <h1 class="work-title">{work.title}</h1>
      <p class="work-subtitle">{work.subtitle}</p>
    </div>
    {work.description && <div class="work-desc">{work.description}</div>}
    {work.video && (
      <div class="work-video">
        <video controls style="width: 100%; max-height: 80vh;">
          <source src={work.video} type="video/mp4" />
        </video>
      </div>
    )}
    {work.images.length > 0 && (
      <div class="carousel" id="carousel">
        <button class="carousel-btn carousel-prev" id="carousel-prev" aria-label="上一张">〈</button>
        <div class="carousel-track" id="carousel-track">
          {work.images.map((img, i) => (
            <img
              class="carousel-img"
              src={img}
              alt=""
              loading="lazy"
              style={i === 0 ? "" : "display: none;"}
            />
          ))}
        </div>
        <button class="carousel-btn carousel-next" id="carousel-next" aria-label="下一张">〉</button>
      </div>
    )}
  </div>
  <script>
    const track = document.getElementById('carousel-track');
    if (track) {
      const imgs = track.querySelectorAll('.carousel-img');
      const prev = document.getElementById('carousel-prev');
      const next = document.getElementById('carousel-next');
      let current = 0;

      function show(i) {
        imgs[current].style.display = 'none';
        current = (i + imgs.length) % imgs.length;
        imgs[current].style.display = 'block';
      }

      prev.addEventListener('click', () => show(current - 1));
      next.addEventListener('click', () => show(current + 1));
    }
  </script>
</BaseLayout>
