---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { works } from "../../data/works";

export function getStaticPaths() {
  return works.map((w) => ({ params: { slug: w.slug } }));
}

const { slug } = Astro.params;
const work = works.find((w) => w.slug === slug);

if (!work) {
  return Astro.redirect("/portfolio");
}
---

<BaseLayout title={work.title}>
  <style>
    .page {
      max-width: 800px;
      margin: 0 auto;
      padding: 8vh var(--spacing-page);
    }

    .back-link {
      display: inline-block;
      font-size: 0.8rem;
      color: var(--color-text-light);
      letter-spacing: 0.08em;
      margin-bottom: 2.5rem;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: var(--color-text);
    }

    .work-header {
      margin-bottom: 3rem;
    }

    .work-title {
      font-size: 1.4rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      margin-bottom: 0.3rem;
    }

    .work-subtitle {
      font-size: 0.85rem;
      color: var(--color-text-light);
      letter-spacing: 0.05em;
    }

    .work-cover {
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      background: #eee;
      margin-bottom: 3rem;
    }

    .work-desc {
      font-size: 0.95rem;
      line-height: 2.1;
      color: var(--color-text);
      white-space: pre-line;
      margin-bottom: 3rem;
    }

    .work-images {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .work-images img {
      width: 100%;
      object-fit: contain;
    }
  </style>

  <div class="page">
    <a class="back-link" href="/portfolio">← 作品集</a>
    <div class="work-header">
      <h1 class="work-title">{work.title}</h1>
      <p class="work-subtitle">{work.subtitle}</p>
    </div>
    {work.description && <div class="work-desc">{work.description}</div>}
    {work.images.length > 0 && (
      <div class="work-images">
        {work.images.map((img) => (
          <img src={img} alt="" loading="lazy" />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
